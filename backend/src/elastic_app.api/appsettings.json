{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DynamoDb": {
    "Storage": {
      "LocalMode": false
    },
    "RetrySetting": {
      "NoOfRetry": 3,
      "Exponent": 2
    },
    "Timeout": "00:00:02"
  },
  "Kestrel": {
    "Certificates": {
      "Development": {
        "Path": "C:/certs/localhost.pfx"
      }
    }
  },
  "EmailSettings": {
    "SmtpServer": "smtp.your-email-provider.com",
    "SmtpPort": "587",
    "FromEmail": "your-email@example.com",
    "Username": "your-email@example.com"
  }
}
